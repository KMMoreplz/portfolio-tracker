# Скопируйте в .env и заполните своими значениями. Файл .env в git не попадает.

# Токен Telegram-бота от @BotFather (обязателен для отправки сообщений;
# без него сервис работает в режиме заглушки и ничего не шлёт).
TELEGRAM_BOT_TOKEN=

# Токен T-Invest API (опционально: без него котировки берутся из MOEX ISS).
T_INVEST_TOKEN=

# Общий секрет подписи JWT (portfolio-service). В проде задать свой!
JWT_SECRET=dev-only-jwt-secret-please-override-0123456789

# Срок жизни токена входа в минутах (по умолчанию 12 часов).
#JWT_TTL_MINUTES=720

# Своя маленькая БД telegram-bot-service (H2): chat id ↔ user id и журнал напоминаний.
#BOT_DB_URL=jdbc:h2:file:./data/bot-db;DB_CLOSE_ON_EXIT=FALSE

# Адреса сервисов (для запуска вне docker compose).
#PORTFOLIO_SERVICE_URL=http://localhost:8080
#MARKET_DATA_BASE_URL=http://localhost:8081

# Вебхуки событий: market-data-service шлёт изменения цен, portfolio-service — события портфеля.
#MARKET_DATA_WEBHOOK_URL=http://localhost:8082/api/events/price
#NOTIFICATIONS_WEBHOOK_URL=http://localhost:8082/api/events
